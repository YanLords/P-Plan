{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planete Plan",
  "version": "0.3.6",
  "identifier": "com.artifeu.planfeu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Planete Plan",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "Artifeu",
    "category": "Utility",
    "shortDescription": "Plans de disposition de feux d'artifice",
    "longDescription": "Générateur local de plans de disposition de feux d'artifice : carte, artifices et distances de sécurité, barriérages, zone public, points de secours, export PDF.",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1NDRDOTdDQkExQTNBNkIKUldSck9ocTZmTWxFWlU4a1RnVEE0bE0rc3BkMTBnaFJtN29kK2QyaE5MVU9SSi9vZE5tU2UzeHgK",
      "endpoints": [
        "https://github.com/YanLords/plan-de-feu-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
